# Production settings for docker-compose.prod.yml. Copy to deploy/.env, fill in, keep it out of git.

# --- Server -------------------------------------------------------------------------------------------
DOMAIN=vargani.example.in
DJANGO_ALLOWED_HOSTS=vargani.example.in
CORS_ALLOWED_ORIGINS=https://vargani.example.in
CSRF_TRUSTED_ORIGINS=https://vargani.example.in
FRONTEND_URL=https://vargani.example.in
API_PUBLIC_URL=https://vargani.example.in

# --- Secrets (generate fresh values; never reuse development ones) -----------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Database ------------------------------------------------------------------------------------------
POSTGRES_DB=vargani
# The application's own database login (an ordinary role, so row-level security applies to it).
POSTGRES_USER=vargani
POSTGRES_PASSWORD=
# The database administrator ("postgres"); only used for maintenance.
POSTGRES_ADMIN_PASSWORD=

# --- SMS (login codes) ---------------------------------------------------------------------------------
# No SMS provider yet (free setup)? Use SMS_BACKEND=apps.accounts.sms.DisabledSMSBackend: everyone uses email.
SMS_BACKEND=apps.accounts.sms.MSG91SMSBackend
SMS_MSG91_AUTH_KEY=
SMS_MSG91_TEMPLATE_ID=

# --- Email (invitations, password reset) ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Vargani <no-reply@vargani.example.in>

# --- Files: local volume by default; or S3-compatible storage ------------------------------------------
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# STORAGE_BUCKET=
# STORAGE_ENDPOINT_URL=
# STORAGE_REGION=ap-south-1
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- Push notifications to the mobile app ------------------------------------------------------------
PUSH_BACKEND=console
# PUSH_BACKEND=fcm
# FCM_SERVICE_ACCOUNT_FILE=/srv/media/../secrets/fcm.json

# --- Monitoring (optional) ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
# SENTRY_DSN=
