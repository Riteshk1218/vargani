msgstr "कुछ गलत हो गया। कृपया फिर से प्रयास करें।"

#: apps/core/phone.py:26
msgid "Enter a valid mobile number."
msgstr "सही मोबाइल नंबर दर्ज करें।"

#: apps/core/serializers.py:14 apps/events/serializers.py:126
msgid "This cannot be changed."
msgstr "इसे बदला नहीं जा सकता।"

#: apps/events/serializers.py:49
msgid "Enter the event name."
msgstr "कार्यक्रम का नाम दर्ज करें।"

#: apps/events/serializers.py:55
msgid "Use only letters and numbers."
msgstr "केवल अक्षर और अंक इस्तेमाल करें।"

