msgstr "हाउसिंग सोसाइटी का रखरखाव, निधि और खर्च।"

#: apps/events/templates.py:53
msgid "Custom"
msgstr "कस्टम"

#: apps/events/templates.py:54
msgid "Start empty and choose the modules yourself."
msgstr "खाली से शुरू करें और मॉड्यूल खुद चुनें।"

#: apps/expenses/attachments.py:32
msgid "Upload a JPG, PNG or WEBP image, or a PDF."
msgstr "JPG, PNG या WEBP फोटो, या PDF अपलोड करें।"

#: apps/expenses/attachments.py:75
msgid "Choose a file."
msgstr "फ़ाइल चुनें।"

#: apps/expenses/attachments.py:82
msgid "An expense can have at most 10 attachments."
msgstr "एक खर्च में अधिकतम 10 बिल जोड़े जा सकते हैं।"

#: apps/expenses/serializers.py:38
msgid "A category with this name already exists."
msgstr "इस नाम की श्रेणी पहले से है।"

