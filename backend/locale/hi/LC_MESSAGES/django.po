msgid "Receipt void requested"
msgstr "रसीद रद्द करने का अनुरोध"

#: apps/notifications/templates.py:25
#, python-format
msgid "%(actor)s asked to void receipt %(number)s (₹%(amount)s): %(reason)s"
msgstr ""
"%(actor)s ने रसीद %(number)s (₹%(amount)s) रद्द करने का अनुरोध किया: "
"%(reason)s"

#: apps/notifications/templates.py:28
msgid "Receipt voided"
msgstr "रसीद रद्द हुई"

#: apps/notifications/templates.py:29
#, python-format
msgid "Your request to void receipt %(number)s was approved by %(actor)s."
msgstr "रसीद %(number)s रद्द करने का आपका अनुरोध %(actor)s ने स्वीकार किया।"

#: apps/notifications/templates.py:32
msgid "Void request rejected"
msgstr "रद्द करने का अनुरोध अस्वीकृत"

#: apps/notifications/templates.py:33
#, python-format
msgid "Your request to void receipt %(number)s was rejected by %(actor)s."
msgstr "रसीद %(number)s रद्द करने का आपका अनुरोध %(actor)s ने अस्वीकार किया।"

#: apps/notifications/templates.py:36
msgid "Thank you for your contribution"
msgstr "आपके योगदान के लिए धन्यवाद"

#: apps/notifications/templates.py:37
#, python-format
msgid "₹%(amount)s received for %(event)s. Receipt no. %(number)s."
msgstr "%(event)s के लिए ₹%(amount)s प्राप्त हुए। रसीद क्र. %(number)s।"

#: apps/notifications/templates.py:40
msgid "Contribution reminder"
msgstr "योगदान अनुस्मारक"

#: apps/notifications/templates.py:41
#, python-format
msgid ""
"₹%(amount)s is due for %(type)s (%(event)s). Please pay your collector or "
"online."
msgstr ""
"%(type)s (%(event)s) के लिए ₹%(amount)s बकाया है। कृपया संग्रहकर्ता को या "
"ऑनलाइन भुगतान करें।"

#: apps/notifications/templates.py:44
msgid "Payment not completed"
msgstr "भुगतान पूरा नहीं हुआ"

#: apps/notifications/templates.py:46
#, python-format
msgid ""
"Your payment of ₹%(amount)s for %(event)s did not go through. Any money "
"deducted will be returned."
msgstr ""
"%(event)s के लिए आपका ₹%(amount)s का ऑनलाइन भुगतान पूरा नहीं हुआ। यदि पैसे "
"कटे हैं तो आपका बैंक उन्हें लौटा देगा।"

#: apps/organizations/serializers.py:49
msgid "Enter the organization name."
msgstr "संस्था का नाम दर्ज करें।"

#: apps/organizations/serializers.py:66 apps/organizations/serializers.py:102
msgid "End date must be after the start date."
msgstr "समाप्ति तिथि आरंभ तिथि के बाद होनी चाहिए।"

#: apps/organizations/serializers.py:100
msgid "A closed financial year cannot be edited."
msgstr "बंद वित्तीय वर्ष को बदला नहीं जा सकता।"

#: apps/organizations/serializers.py:107
msgid "A financial year with this label already exists."
msgstr "इस नाम का वित्तीय वर्ष पहले से मौजूद है।"

#: apps/organizations/serializers.py:109
msgid "This financial year overlaps another financial year."
msgstr "यह वित्तीय वर्ष दूसरे वित्तीय वर्ष से टकराता है।"

#: apps/organizations/services.py:96
msgid "Unknown setting."
msgstr "अज्ञात सेटिंग।"

#: apps/organizations/services.py:98
msgid "Invalid value."
msgstr "गलत मान।"

#: apps/organizations/services.py:112
msgid "Upload a PNG, JPG, JPEG or WEBP image."
msgstr "PNG, JPG, JPEG या WEBP छवि अपलोड करें।"

#: apps/organizations/services.py:118
msgid "The file is too large."
msgstr "फ़ाइल बहुत बड़ी है।"

#: apps/organizations/services.py:142
msgid "The image is too small. Use at least 512 × 512 pixels."
msgstr "छवि बहुत छोटी है। कम से कम 512 × 512 पिक्सेल इस्तेमाल करें।"

#: apps/organizations/services.py:204
msgid "A closed financial year cannot be made current."
msgstr "बंद वित्तीय वर्ष को चालू नहीं किया जा सकता।"

#: apps/organizations/services.py:276
msgid "This person already has access to the organization."
msgstr "इस व्यक्ति को संस्था में पहले से पहुँच है।"

#: apps/organizations/services.py:310
#, python-format
msgid ""
"You have been invited to join %(org)s as %(role)s. Open this link to accept:"
" %(link)s"
msgstr ""
"आपको %(org)s में %(role)s के रूप में जुड़ने का निमंत्रण है। स्वीकार करने के "
"लिए यह लिंक खोलें: %(link)s"

#: apps/organizations/services.py:315
#, python-format
msgid "Invitation to %(org)s"
msgstr "%(org)s से निमंत्रण"

#: apps/organizations/services.py:335
msgid "This invitation is invalid or has expired."
msgstr "यह निमंत्रण अमान्य है या उसकी समय-सीमा समाप्त हो गई है।"

#: apps/organizations/services.py:342
msgid "This invitation was sent to a different email or mobile number."
msgstr "यह निमंत्रण किसी दूसरे ईमेल या मोबाइल नंबर पर भेजा गया था।"

#: apps/organizations/services.py:352
msgid "You already have access to this organization."
msgstr "आपको इस संस्था में पहले से पहुँच है।"

