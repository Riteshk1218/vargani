#: apps/expenses/services.py:132 apps/receipts/voids.py:63
msgid "Someone other than the requester must approve this."
msgstr "अनुरोध करने वाले के अलावा किसी और को इसे स्वीकृत करना होगा।"

#: apps/expenses/services.py:150 apps/expenses/services.py:171
#: apps/expenses/services.py:207
msgid "Give a reason."
msgstr "कारण बताएं।"

#: apps/expenses/services.py:177
msgid "Only an approver can void an approved expense."
msgstr "स्वीकृत खर्च केवल स्वीकृति देने वाले ही रद्द कर सकते हैं।"

#: apps/funds/serializers.py:38
msgid "This event already has a fund with this name."
msgstr "इस कार्यक्रम में इस नाम का फंड पहले से है।"

#: apps/gateway/services.py:33
msgid ""
"Online payment is not available right now. Please try again later or pay "
"your collector."
msgstr ""
"ऑनलाइन भुगतान अभी उपलब्ध नहीं है। कृपया बाद में प्रयास करें या अपने "
"संग्रहकर्ता को भुगतान करें।"

#: apps/gateway/services.py:54
msgid "Online payment"
msgstr "ऑनलाइन भुगतान"

#: apps/gateway/services.py:99
