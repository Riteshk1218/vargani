#: apps/gateway/services.py:118
msgid "Payment not found."
msgstr "भुगतान नहीं मिला।"

#: apps/gateway/services.py:128
msgid "The payment could not be verified."
msgstr "भुगतान का सत्यापन नहीं हो सका।"

