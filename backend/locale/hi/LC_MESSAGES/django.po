msgstr "चालू करने से पहले key id और key secret दर्ज करें।"

#: apps/notifications/templates.py:12
msgid "Expense waiting for approval"
msgstr "खर्च मंज़ूरी की प्रतीक्षा में"

#: apps/notifications/templates.py:13
#, python-format
msgid "%(actor)s sent ₹%(amount)s paid to %(payee)s for approval."
msgstr "%(actor)s ने %(payee)s को दिए गए ₹%(amount)s मंज़ूरी के लिए भेजे।"

#: apps/notifications/templates.py:16
msgid "Expense approved"
msgstr "खर्च स्वीकृत"

#: apps/notifications/templates.py:17
#, python-format
msgid "₹%(amount)s paid to %(payee)s was approved by %(actor)s."
msgstr "%(payee)s को दिए गए ₹%(amount)s %(actor)s ने स्वीकृत किए।"

