#: apps/accounts/otp.py:32
msgid "Please wait before requesting another code."
msgstr "दुसरा कोड मागण्यापूर्वी कृपया थोडा वेळ थांबा."

#: apps/accounts/otp.py:34
msgid "Too many codes requested. Try again later."
msgstr "खूप वेळा कोड मागितला आहे. थोड्या वेळाने पुन्हा प्रयत्न करा."

#: apps/accounts/otp.py:47
#, python-format
msgid ""
"Your verification code is %(code)s. It expires in %(minutes)s minutes. Do "
"not share it."
msgstr ""
"तुमचा पडताळणी कोड %(code)s आहे. तो %(minutes)s मिनिटांत संपेल. तो कोणालाही "
"सांगू नका."

#: apps/accounts/otp.py:51
msgid "Your verification code"
msgstr "तुमचा पडताळणी कोड"

#: apps/accounts/otp.py:82 apps/accounts/views.py:65
#: apps/accounts/views.py:177
msgid "The code is invalid or has expired."
msgstr "कोड चुकीचा आहे किंवा त्याची मुदत संपली आहे."

#: apps/accounts/serializers.py:55 apps/organizations/serializers.py:167
msgid "Enter an email address or a mobile number."
msgstr "ईमेल पत्ता किंवा मोबाइल नंबर टाका."

#: apps/accounts/services.py:19
msgid "An account with these details already exists. Please log in."
msgstr "या तपशिलांसह खाते आधीच अस्तित्वात आहे. कृपया लॉग इन करा."

#: apps/accounts/services.py:25
msgid "Please verify your account before logging in."
msgstr "लॉग इन करण्यापूर्वी कृपया तुमचे खाते पडताळा."

#: apps/accounts/services.py:123
msgid "Invalid login details."
msgstr "लॉग इन तपशील चुकीचे आहेत."

#: apps/accounts/views.py:113 apps/accounts/views.py:115
msgid "Refresh token required."
msgstr "रिफ्रेश टोकन आवश्यक आहे."

#: apps/accounts/views.py:160
msgid "If an account exists, a reset code has been sent."
msgstr "खाते अस्तित्वात असल्यास, रीसेट कोड पाठवला आहे."

#: apps/accounts/views.py:184
msgid "Your password has been reset. Please log in."
msgstr "तुमचा पासवर्ड रीसेट झाला आहे. कृपया लॉग इन करा."

#: apps/accounts/views.py:196
msgid "Your current password is incorrect."
msgstr "तुमचा सध्याचा पासवर्ड चुकीचा आहे."

#: apps/core/exceptions.py:24
msgid "Select an organization (X-Organization-ID header)."
msgstr "संस्था निवडा."

#: apps/core/exceptions.py:30
msgid "You are not a member of this organization."
msgstr "तुम्ही या संस्थेचे सदस्य नाही."

#: apps/core/exceptions.py:36
msgid "Select an event (event parameter)."
msgstr "कार्यक्रम निवडा."

#: apps/core/exceptions.py:42
msgid "This conflicts with existing data."
msgstr "हे आधीच्या माहितीशी जुळत नाही."

#: apps/core/exceptions.py:48
msgid "This action is not allowed in the record's current state."
msgstr "सध्याच्या स्थितीत ही क्रिया करता येणार नाही."

#: apps/core/exceptions.py:54
msgid "This request breaks a business rule."
msgstr "ही विनंती नियमांनुसार करता येणार नाही."

#: apps/core/exceptions.py:73
msgid "Some fields are invalid."
msgstr "काही माहिती चुकीची आहे."

#: apps/core/exceptions.py:74
msgid "Not found."
msgstr "सापडले नाही."

#: apps/core/exceptions.py:113
msgid "Something went wrong. Please try again."
msgstr "काहीतरी चुकले. कृपया पुन्हा प्रयत्न करा."

#: apps/core/phone.py:26
msgid "Enter a valid mobile number."
msgstr "योग्य मोबाइल नंबर टाका."

#: apps/events/serializers.py:36
msgid "Enter the event name."
msgstr "कार्यक्रमाचे नाव टाका."

#: apps/events/serializers.py:42
msgid "Use only letters and numbers."
msgstr "फक्त अक्षरे आणि अंक वापरा."

#: apps/events/serializers.py:47
msgid "Unknown module or invalid value."
msgstr "अज्ञात विभाग किंवा चुकीचे मूल्य."

#: apps/events/serializers.py:55
msgid "An event cannot move to another financial year."
msgstr "कार्यक्रम दुसऱ्या आर्थिक वर्षात हलवता येत नाही."

#: apps/events/serializers.py:57
msgid "This financial year is closed."
msgstr "हे आर्थिक वर्ष बंद आहे."

#: apps/events/serializers.py:61
msgid "End date must be on or after the start date."
msgstr "शेवटची तारीख सुरुवातीच्या तारखेनंतर किंवा त्याच दिवशी हवी."

#: apps/events/serializers.py:80
msgid "Another event in this financial year uses this code."
msgstr "या आर्थिक वर्षातील दुसरा कार्यक्रम हा कोड वापरतो."

#: apps/events/serializers.py:100
msgid "This cannot be changed."
msgstr "हे बदलता येत नाही."

#: apps/events/serializers.py:103
msgid "This person is already part of the event."
msgstr "ही व्यक्ती आधीच कार्यक्रमात आहे."

#: apps/events/templates.py:9
msgid "Festival"
msgstr "उत्सव"

#: apps/events/templates.py:10
msgid "Festivals such as Ganesh Chaturthi, Navratri or Dahi Handi."
msgstr "गणेश चतुर्थी, नवरात्री किंवा दहीहंडी यांसारखे उत्सव."

#: apps/events/templates.py:15
msgid "Fundraising"
msgstr "निधी संकलन"

#: apps/events/templates.py:16
msgid "A campaign that collects donations towards a goal."
msgstr "ठराविक उद्दिष्टासाठी देणगी गोळा करणारी मोहीम."

#: apps/events/templates.py:21
msgid "Membership"
msgstr "सभासदत्व"

#: apps/events/templates.py:22
msgid "Annual or monthly membership and Vargani collection."
msgstr "वार्षिक किंवा मासिक सभासदत्व आणि वर्गणी संकलन."

#: apps/events/templates.py:27
msgid "Society"
msgstr "सोसायटी"

#: apps/events/templates.py:28
msgid "Housing society maintenance, funds and expenses."
msgstr "गृहनिर्माण सोसायटीची देखभाल, निधी आणि खर्च."

#: apps/events/templates.py:33
msgid "Custom"
msgstr "सानुकूल"

#: apps/events/templates.py:34
msgid "Start empty and choose the modules yourself."
msgstr "रिकाम्यापासून सुरू करा आणि विभाग स्वतः निवडा."

#: apps/organizations/serializers.py:35
msgid "Enter the organization name."
msgstr "संस्थेचे नाव टाका."

#: apps/organizations/serializers.py:52 apps/organizations/serializers.py:88
msgid "End date must be after the start date."
msgstr "शेवटची तारीख सुरुवातीच्या तारखेनंतर हवी."

#: apps/organizations/serializers.py:86
msgid "A closed financial year cannot be edited."
msgstr "बंद आर्थिक वर्ष बदलता येत नाही."

#: apps/organizations/serializers.py:93
msgid "A financial year with this label already exists."
msgstr "या नावाचे आर्थिक वर्ष आधीच आहे."

#: apps/organizations/serializers.py:95
msgid "This financial year overlaps another financial year."
msgstr "हे आर्थिक वर्ष दुसऱ्या आर्थिक वर्षाशी जुळते."

#: apps/organizations/services.py:69
msgid "Unknown setting."
msgstr "अज्ञात सेटिंग."

#: apps/organizations/services.py:71
msgid "Invalid value."
msgstr "चुकीचे मूल्य."

#: apps/organizations/services.py:85
msgid "Upload a PNG, JPG, JPEG or WEBP image."
msgstr "PNG, JPG, JPEG किंवा WEBP प्रतिमा अपलोड करा."

#: apps/organizations/services.py:91
msgid "The file is too large."
msgstr "फाइल खूप मोठी आहे."

#: apps/organizations/services.py:115
msgid "The image is too small. Use at least 512 × 512 pixels."
msgstr "प्रतिमा खूप लहान आहे. किमान 512 × 512 पिक्सेल वापरा."

#: apps/organizations/services.py:165
msgid "A closed financial year cannot be made current."
msgstr "बंद आर्थिक वर्ष चालू करता येत नाही."

#: apps/organizations/services.py:221
msgid "This person already has access to the organization."
msgstr "या व्यक्तीला संस्थेत आधीच प्रवेश आहे."

#: apps/organizations/services.py:245
#, python-format
msgid ""
"You have been invited to join %(org)s as %(role)s. Open this link to accept:"
" %(link)s"
msgstr ""
"तुम्हाला %(org)s मध्ये %(role)s म्हणून सामील होण्याचे निमंत्रण आहे. "
"स्वीकारण्यासाठी ही लिंक उघडा: %(link)s"

#: apps/organizations/services.py:248
#, python-format
msgid "Invitation to %(org)s"
msgstr "%(org)s कडून निमंत्रण"

#: apps/organizations/services.py:270
msgid "This invitation is invalid or has expired."
msgstr "हे निमंत्रण अवैध आहे किंवा त्याची मुदत संपली आहे."

#: apps/organizations/services.py:277
msgid "This invitation was sent to a different email or mobile number."
msgstr "हे निमंत्रण दुसऱ्या ईमेल किंवा मोबाइल नंबरवर पाठवले होते."

#: apps/organizations/services.py:286
msgid "You already have access to this organization."
msgstr "तुम्हाला या संस्थेत आधीच प्रवेश आहे."

#: apps/organizations/services.py:324
msgid "The organization must keep at least one active Organization Admin."
msgstr "संस्थेत किमान एक सक्रिय संस्था प्रशासक असणे आवश्यक आहे."

#: apps/people/serializers.py:29
msgid "Enter the person's name."
msgstr "व्यक्तीचे नाव टाका."

