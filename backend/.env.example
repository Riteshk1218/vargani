# Copy to .env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://vargani:vargani@localhost:5432/vargani
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Storage: local (default) or s3 (works with AWS S3, Cloudflare R2, Supabase Storage)
STORAGE_BACKEND=local
# STORAGE_BUCKET=
# STORAGE_ENDPOINT_URL=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Email (console backend prints emails to the terminal in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@localhost

# SMS: console backend prints OTPs to the terminal. A real provider arrives in Phase 5.
SMS_BACKEND=apps.accounts.sms.ConsoleSMSBackend

# Development only: return OTP codes in API responses so you can test without email/SMS.
OTP_DEBUG_ECHO=true

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Public address of this API (used for the payment gateway webhook URL shown in Settings).
API_PUBLIC_URL=http://localhost:8000
# Encrypts payment gateway secrets in the database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. Keep it safe: without it saved gateway secrets cannot be read.
FIELD_ENCRYPTION_KEY=

# Push notifications to the mobile app: console (logs only) or fcm.
PUSH_BACKEND=console
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# FCM_PROJECT_ID=
